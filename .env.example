# =====================================================================================
# AI Pinterest Affiliate Engine: copy to `.env` and fill in. NEVER commit `.env`.
# Real environment variables always win over this file.
# =====================================================================================

# ---- App -----------------------------------------------------------------------------
APP_ENV=dev                       # dev | production (production refuses weak/default secrets)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me          # REQUIRED to change before real use (login password for the dashboard)
SECRET_KEY=                       # 32+ random chars. Signs sessions AND derives the key that encrypts
                                  # your Pinterest tokens. Required in production. Changing it = reconnect Pinterest.
                                  # (In dev, if empty, one is generated and kept in data/engine/.secret_key)
# DATABASE_URL=sqlite:///data/engine/engine.db
# DATA_DIR=data/engine
ENABLE_DEMO_PROVIDER=true         # fictional demo catalog; demo pins can never go to a real Pinterest account

# ---- Pinterest (official API v5, OAuth 2.0). See engine-docs/PINTEREST_SETUP.md ---------
PINTEREST_PROVIDER=real           # real | mock  (mock = SIMULATION: nothing is sent to Pinterest)
PINTEREST_CLIENT_ID=              # "App id" from https://developers.pinterest.com/apps/
PINTEREST_CLIENT_SECRET=          # "App secret key" (server side only, never shown in the UI)
PINTEREST_REDIRECT_URI=http://localhost:8000/pinterest/callback   # must EXACTLY match the one registered in your app
# PINTEREST_SCOPES=boards:read,boards:write,pins:read,pins:write,user_accounts:read
SCHEDULER_ENABLED=false           # true = `python -m app.worker` may publish scheduled pins automatically
MAX_PINS_PER_DAY=3                # scheduler limit
SCHEDULE_SLOTS=09:00,14:00,20:00
SCHEDULE_TZ=Asia/Kolkata

# ---- Amazon Associates India: Creators API (successor of PA-API 5.0, which was retired) ----
# Credentials are issued in Associates Central to eligible accounts. The old PA-API
# access key/secret key do NOT work. Without these, use the CSV import workflow.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=               # your tag, e.g. yourname-21 (also used to build tagged links in CSV import)
AMAZON_MARKETPLACE=www.amazon.in
AMAZON_CREDENTIAL_VERSION=3.2     # 3.2 = EU/India credential version

# ---- EarnKaro: no public API found, import/manual only -------------------------------------
EARNKARO_LINK_DOMAINS=ekaro.in,earnkaro.com   # domains accepted as genuine Profit Links

# ---- AI copywriting (optional; default is free, deterministic and offline) --------------------
AI_PROVIDER=local                 # local | openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# =====================================================================================
# Legacy static-site tool (pinbot/), unrelated to the app above
# =====================================================================================
SITE_URL=https://example.github.io/pinterest
SITE_NAME=My Picks
# PINTEREST_ACCESS_TOKEN=         # only used by the legacy `python -m pinbot publish --live`
# PINTEREST_BOARD_ID=
